# OpenAI-compatible model endpoint.
JARVIS_MODEL=qwen3:8b
JARVIS_VOICE_MODEL=qwen3:8b
JARVIS_REASONING_MODEL=
JARVIS_CODE_MODEL=
JARVIS_VISION_MODEL=
JARVIS_VISION_BASE_URL=
JARVIS_VISION_API_KEY=
JARVIS_EMBEDDING_MODEL=
JARVIS_COMPUTER_MODEL=
JARVIS_MODEL_FALLBACKS=
JARVIS_MODEL_FALLBACK_ROLES=chat,voice,reasoning,code,computer
JARVIS_MODEL_FALLBACK_BASE_URL=
JARVIS_MODEL_FALLBACK_API_KEY=
JARVIS_MODEL_BUDGET_FALLBACK=
JARVIS_BUDGET_DOWNSHIFT_RATIO=0.8
JARVIS_MODEL_BASE_URL=http://127.0.0.1:11434/v1
JARVIS_MODEL_API_KEY=ollama
JARVIS_REASONING_EFFORT=none
JARVIS_MAX_TOKENS=2048
JARVIS_VOICE_MAX_TOKENS=512
JARVIS_VOICE_MAX_ITERATIONS=16
JARVIS_VOICE_TTS_CHUNK_CHARS=100
JARVIS_VOICE_TTS_MAX_CONCURRENT=4
JARVIS_VOICE_MAX_SPOKEN_CHARS=1000
JARVIS_CONTEXT_MAX_CHARS=18000
JARVIS_MEMORY_EXTRACTION_ENABLED=1
JARVIS_PROACTIVE_ENABLED=1
JARVIS_PROACTIVE_MIN_PRIORITY=3
JARVIS_PROACTIVE_STALE_TASK_MINUTES=30
JARVIS_PROACTIVE_QUIET_HOURS=
JARVIS_KEEP_ALIVE=2h

# Alternative cloud example:
# JARVIS_MODEL=deepseek-chat
# JARVIS_MODEL_BASE_URL=https://api.deepseek.com
# JARVIS_MODEL_API_KEY=replace-me
# JARVIS_REASONING_EFFORT=

JARVIS_ASSISTANT_NAME=丽萨
JARVIS_USER_NAME=
JARVIS_TIMEZONE=Asia/Shanghai
JARVIS_PERSONA_MODE=butler
JARVIS_BRIDGE_TOKEN=
JARVIS_BROWSER_BACKEND=web
JARVIS_REQUEST_TOKEN_BUDGET=12000
JARVIS_TASK_TOKEN_BUDGET=120000
JARVIS_DAILY_TOKEN_BUDGET=500000
JARVIS_INPUT_COST_PER_MILLION=0
JARVIS_OUTPUT_COST_PER_MILLION=0
JARVIS_PLUGIN_DIRS=
JARVIS_DATA_DIR=~/.jarvis
JARVIS_WORKSPACE=.
JARVIS_ENVIRONMENT=development

# Production runtime.
JARVIS_LOGGING_LEVEL=INFO
JARVIS_LOGGING_MAX_BYTES=10485760
JARVIS_LOGGING_RETENTION_DAYS=14
JARVIS_PERFORMANCE_MODE=BALANCED
JARVIS_VISION_FREQUENCY_SECONDS=8
JARVIS_BACKGROUND_TASKS_ENABLED=1
JARVIS_OFFLINE_MODE=0
JARVIS_NETWORK_PROXY=
JARVIS_WAKE_WORD_ENABLED=1
JARVIS_CLOSE_TO_TRAY=1

# Update/plugin signing keys are stored by SecretManager, not in config.json.
JARVIS_UPDATE_CHANNEL=stable
JARVIS_UPDATE_MANIFEST_URL=
JARVIS_UPDATE_AUTO_CHECK=1
JARVIS_UPDATE_SIGNING_KEY=
JARVIS_PLUGIN_SIGNING_KEY=

# Permission policy. Values are comma-separated glob patterns.
JARVIS_PERMISSION_AUTO_APPROVE=READ_ONLY,LOW_RISK,NORMAL,MEDIUM_RISK
JARVIS_PERMISSION_ALLOWED_APPS=*
JARVIS_PERMISSION_ALLOWED_FOLDERS=
JARVIS_PERMISSION_ALLOWED_COMMANDS=
JARVIS_PERMISSION_ALLOWED_MESSAGE_RECIPIENTS=文件传输助手
JARVIS_PERMISSION_BLOCKED_APPS=
JARVIS_PERMISSION_BLOCKED_PATHS=
JARVIS_PERMISSION_BLOCKED_COMMANDS=

# Optional JSON array of MCP server definitions.
# Example:
# JARVIS_MCP_SERVERS=[{"name":"demo","command":["python","scripts/example_mcp_server.py"]}]
JARVIS_MCP_SERVERS=

# Voice defaults. Set JARVIS_WHISPER_DEVICE=cuda after CUDA runtime setup.
JARVIS_WHISPER_MODEL=small
JARVIS_WHISPER_PARTIAL_MODEL=base
JARVIS_WHISPER_DEVICE=cpu
JARVIS_WHISPER_COMPUTE_TYPE=int8
JARVIS_WHISPER_INITIAL_PROMPT=以下是中文语音对话。常用词：贾维斯、Jarvis、DeepSeek、Codex、MCP、Electron、Python、PowerShell、Ollama、VS Code、浏览器、微信、QQ、截图、打开、关闭、停止、暂停、继续、取消、运行测试、查看文件。
JARVIS_ASR_PROVIDER_ORDER=qwen3-asr,paraformer-zh-streaming,sensevoice,whisper
JARVIS_ASR_SHERPA_MODEL_DIR=~/.jarvis/models/sherpa-onnx/streaming-paraformer-bilingual-zh-en
JARVIS_ASR_SHERPA_NUM_THREADS=2
JARVIS_ASR_SHERPA_PROVIDER=cpu
JARVIS_ASR_SENSEVOICE_MODEL_DIR=~/.jarvis/models/sherpa-onnx/sense-voice-zh-en-ja-ko-yue-2024-07-17
JARVIS_ASR_SENSEVOICE_NUM_THREADS=2
JARVIS_ASR_SENSEVOICE_PROVIDER=cpu
JARVIS_ASR_SENSEVOICE_LANGUAGE=auto
JARVIS_ASR_HOTWORDS=贾维斯,Jarvis,DeepSeek,Codex,MCP,Electron,Python,PowerShell,VS Code,Ollama,浏览器,微信,QQ,截图,打开,关闭,停止,暂停,继续,取消
JARVIS_ASR_PARTIAL_WINDOW_SECONDS=8
JARVIS_ASR_PARTIAL_INTERVAL_SECONDS=0.4
JARVIS_ASR_NO_SPEECH_THRESHOLD=0.6
JARVIS_ASR_FINAL_BEAM_SIZE=2
JARVIS_ASR_FINAL_VAD_FILTER=1
JARVIS_ASR_SHORT_FINAL_SECONDS=2.5
JARVIS_ASR_SHORT_FINAL_BEAM_SIZE=2
JARVIS_TTS_BACKEND=edge
JARVIS_TTS_VOICE=zh-CN-YunyangNeural
JARVIS_TTS_PIPER_VOICE=zh_CN-huayan-medium
JARVIS_TTS_RATE=+25%
JARVIS_TTS_LENGTH_SCALE=0.82
